# Copy to /etc/mavlink-sign.env on the Pi (owner shis:shis, mode 600 - the signer runs as shis and
# reads this file itself). Must match the Fly secret MAV_SIGNING_KEY on the streamscope-mavlink app.
# Use 64 hex characters: both ends treat that as the raw 32-byte key, anything else is SHA-256'd as
# a passphrase, so a stray quote silently produces two different keys and every frame drops as badsig.
MAV_SIGNING_KEY=<64-hex-character-key>
